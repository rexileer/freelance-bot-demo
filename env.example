# Telegram Bot Configuration
# Получить токен у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# Telegram Admin ID (ваш ID в Telegram)
# Узнать можно у @userinfobot
ADMIN_ID=your_admin_telegram_id

# Telegram Parser Configuration (UserBot)
# Получить на https://my.telegram.org
# Войдите в аккаунт и создайте приложение
TG_PARSER_API_ID=your_api_id_here
TG_PARSER_API_HASH=your_api_hash_here

# Django Configuration
# Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_django_secret_key_here

# Port Configuration
# Внешний порт для Django Admin (внутри контейнера всегда 8000)
DJANGO_PORT=8000

# PostgreSQL Configuration
# Внешний порт для маппинга PostgreSQL (внутри контейнера всегда 5432)
PG_PORT=5432

# Внутренние настройки PostgreSQL (не изменять)
PG_HOST=postgres_db
PG_NAME=freelance_db
PG_USER=postgres
PG_PASSWORD=qH6~*8tq&

# Дополнительные настройки (опционально)
# DEBUG=True  # Только для разработки
# ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com 